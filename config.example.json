      "remaining": 500,
      "note": "Pro 每月快速请求额度, 双击卡片更新",
      "processes": [
        "Cursor.exe"
      ]
    },
    {
      "id": "kimi",
      "name": "Kimi",
      "type": "kimi",
      "unit": "%",
      "note": "Coding Plan 额度",
      "processes": [
        "Kimi.exe"
      ],
      "launch": "C:\\Users\\<你>\\AppData\\Local\\Programs\\kimi-desktop\\Kimi.exe"
    },
    {
      "id": "trae-main",
      "name": "Trae 主号",
